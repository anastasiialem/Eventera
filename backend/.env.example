# Copy this file to backend/.env and fill in the values.
# .env is already in .gitignore, so real keys never end up in git.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: writes to tables bypassing RLS. Parser/backend only,
# never in the frontend and never in a chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- API + Telegram bot (backend/app) ---
# @BotFather token for @Eventera_lviv_bot (secret)
TELEGRAM_BOT_TOKEN=
# random strings, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_API_KEY=
# Render URL of this service (https://...onrender.com). Empty locally = no webhook.
PUBLIC_BASE_URL=
# Site URL: links in bot messages + CORS
FRONTEND_URL=http://localhost:5173
# Telegram chat_id of admins, comma-separated (/admin in the bot)
ADMIN_CHAT_IDS=
