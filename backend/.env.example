# Скопіюй у backend/.env і заповни. backend/.env у git НЕ потрапляє (.gitignore).
#
# SUPABASE_URL — Supabase → Project Settings → API → Project URL (не секрет)
# SUPABASE_SERVICE_ROLE_KEY — там само, "service_role" (СЕКРЕТ!)
#   • лише цей ключ може писати в базу: він обходить усі правила доступу (RLS)
#   • тільки на сервері: у backend/.env локально і в Environment на Render
#   • ніколи не комітити, не класти у фронтенд / Vercel, не кидати в загальний чат

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
