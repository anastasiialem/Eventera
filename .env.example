# Кореневий .env для Docker Compose (infra/docker-compose.yml).
# Скопіюй у .env і заповни. .env у .gitignore — реальні ключі в git не потрапляють.
# Для запуску без Docker: frontend/.env.local (frontend/.env.example) і backend/.env (backend/.env.example).

# ---------- Frontend (вшиваються в JS під час збірки — тільки публічні значення!) ----------
# Supabase → Project Settings → API. Лише anon key. service_role НІКОЛИ не клади у VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# API подій Ролі 3 (поки порожньо → Supabase напряму → моки)
VITE_API_URL=
# Бекенд (прив'язка Telegram). Локально в Docker: http://localhost:8000
VITE_BACKEND_URL=
# Банка monobank «Повернись живим»
VITE_DONATE_URL=
# Банка «Eventera VIP» (39 ₴/міс)
VITE_VIP_PAY_URL=
# Куди йдуть кошти VIP (порожньо → дефолтний текст)
VITE_VIP_NOTE=
VITE_TELEGRAM_BOT_URL=
# true / false
VITE_ENABLE_GOOGLE=

# ---------- Backend + parser (секрети, тільки сервер) ----------
SUPABASE_URL=
# service_role: пише в таблиці в обхід RLS. Лише backend/parser.
SUPABASE_SERVICE_ROLE_KEY=
# @BotFather токен @Eventera_lviv_bot
TELEGRAM_BOT_TOKEN=
# випадкові рядки: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
INTERNAL_API_KEY=
# Публічна адреса для webhook. Порожньо локально = без webhook
PUBLIC_BASE_URL=
# Адреса сайту (посилання в боті + CORS). Локально в Docker: http://localhost:8080
FRONTEND_URL=
# chat_id адмінів через кому (/admin у боті)
ADMIN_CHAT_IDS=

# ---------- Parser ----------
# Джерела через кому: karabas,concert_ua (порожньо = усі)
PARSER_SOURCES=
