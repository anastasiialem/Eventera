# Supabase (Project Settings → API). Лише anon key, НІКОЛИ service_role!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API Ролі 3 (Render). Порожньо — читаємо Supabase напряму, без Supabase — моки
VITE_API_URL=

# Банка monobank «Повернись живим»
VITE_DONATE_URL=https://send.monobank.ua/jar/XXXXXXXXXX

# Telegram-бот
VITE_TELEGRAM_BOT_URL=https://t.me/eventera_bot

# Показувати кнопку «Продовжити з Google» (true/false)
VITE_ENABLE_GOOGLE=false
