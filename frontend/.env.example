# Supabase (Project Settings → API). Лише anon key, НІКОЛИ service_role!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API подій Ролі 3. Поки ПОРОЖНЬО — читаємо Supabase напряму, без Supabase — моки
VITE_API_URL=

# Бекенд Ролі 3 на Render — поки лише для прив'язки Telegram (POST /api/telegram/link)
VITE_BACKEND_URL=https://eventera-api-hbgc.onrender.com

# Банка monobank «Повернись живим»
VITE_DONATE_URL=https://send.monobank.ua/jar/XXXXXXXXXX

# Telegram-бот
VITE_TELEGRAM_BOT_URL=https://t.me/Eventera_lviv_bot

# Показувати кнопку «Продовжити з Google» (true/false)
VITE_ENABLE_GOOGLE=false
